# Copie para .env:  cp .env.example .env
# Local: o Spring Boot lê src/back/.env automaticamente ao rodar em src/back.
# Render: replique estas chaves em Environment Variables (o .env não vai para o servidor).

# --- Banco Neon (recomendado: uma URL só) ---
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/neondb?sslmode=require

# --- Banco local (alternativa: comente DATABASE_URL e use estas) ---
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=servify
# DB_USER=postgres
# DB_PASSWORD=root

# --- Segurança (obrigatório trocar em produção) ---
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# --- Front / CORS ---
FRONTEND_BASE_URL=http://localhost:5173
# Render (ajuste para a URL real do front):
# FRONTEND_BASE_URL=https://seu-front.onrender.com
# CORS_ALLOWED_ORIGIN_PATTERNS=https://seu-front.onrender.com

# --- Gmail (opcional) ---
SERVIFY_GMAIL_ENABLED=false
SERVIFY_GMAIL_SENDER_EMAIL=
SERVIFY_GMAIL_OAUTH_REDIRECT_URI=
