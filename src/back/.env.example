# Copie para .env:  cp .env.example .env
# Local: o Spring Boot lê src/back/.env automaticamente ao rodar em src/back.
# Render: replique estas chaves em Environment Variables (o .env não vai para o servidor).

# --- Banco Neon (variáveis separadas — recomendado) ---
PGHOST=seu-host.neon.tech
PGDATABASE=neondb
PGUSER=seu_usuario
PGPASSWORD=sua_senha
PGSSLMODE=require

# --- Banco local (alternativa: comente PG* e use estas) ---
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=servify
# DB_USER=postgres
# DB_PASSWORD=root

# --- Segurança (obrigatório trocar em produção) ---
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# --- Front / CORS ---
FRONTEND_BASE_URL=https://plf-es-2026-1-ti2-1381100-grupo3-servify.onrender.com
CORS_ALLOWED_ORIGIN_PATTERNS=https://plf-es-2026-1-ti2-1381100-grupo3-servify.onrender.com
SERVIFY_GMAIL_OAUTH_REDIRECT_URI=https://plf-es-2026-1-ti2-1381100-grupo3-servify.onrender.com/oauth/google/callback

# --- Gmail (opcional) ---
SERVIFY_GMAIL_ENABLED=false
SERVIFY_GMAIL_SENDER_EMAIL=
